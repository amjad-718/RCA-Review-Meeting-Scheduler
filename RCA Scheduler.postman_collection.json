      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"googleAccessToken\": \"{{GOOGLE_ACCESS_TOKEN}}\",\n  \"devrevApiKey\": \"{{DEVREV_API_KEY}}\",\n  \"incidentId\": \"{{INCIDENT_ID}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/scheduleRCA",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "scheduleRCA"]
        }
