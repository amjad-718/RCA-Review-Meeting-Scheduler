      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"busySlots\": [],\n  \"duration\": 30\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/findAvailableSlot",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "findAvailableSlot"]
        }
      }
    },
    {
      "name": "📆 Schedule Event",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"googleAccessToken\": \"{{GOOGLE_ACCESS_TOKEN}}\",\n  \"ownerEmail\": \"owner@company.com\",\n  \"authorEmail\": \"author@company.com\",\n  \"reviewerEmail\": \"reviewer@company.com\",\n  \"incidentId\": \"INC-12345\",\n  \"chosenSlot\": {\n    \"start\": \"2025-10-23T10:00:00+05:30\",\n    \"end\": \"2025-10-23T10:30:00+05:30\"\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/scheduleEvent",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "scheduleEvent"]
